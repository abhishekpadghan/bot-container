# ─────────────────────────────────────────────────────────────
# Angel One SmartAPI Credentials
# Get from: https://smartapi.angelbroking.com
# ─────────────────────────────────────────────────────────────
API_KEY=your_api_key_here
CLIENT_ID=your_angel_one_client_id
PASSWORD=your_mpin_here
TOTP_SECRET=your_totp_secret_from_google_authenticator

# ─────────────────────────────────────────────────────────────
# Trading Mode
# paper = simulate trades locally (NO real orders placed)
# live  = real orders via SmartAPI (USE WITH CAUTION)
# ─────────────────────────────────────────────────────────────
TRADING_MODE=paper

# ─────────────────────────────────────────────────────────────
# Instruments to trade (comma-separated, no spaces)
# Supported: NIFTY, SENSEX, BANKNIFTY, BANKEX, FINNIFTY
# ─────────────────────────────────────────────────────────────
INSTRUMENTS=NIFTY,SENSEX

# ─────────────────────────────────────────────────────────────
# Risk Parameters
# ─────────────────────────────────────────────────────────────
LOT_SIZE=65                   # Global default lot size (NIFTY=65 as of 2025)
PROFIT_TARGET_POINTS=20       # Exit trade at +20 points profit
STOP_LOSS_POINTS=10           # Exit trade at -10 points loss
DAILY_PROFIT_TARGET=1500      # Stop bot for the day at ₹1500 profit
DAILY_MAX_LOSS=750            # Stop bot for the day at ₹750 loss
MAX_TRADES_PER_DAY=5          # Maximum trades allowed per day

# ─────────────────────────────────────────────────────────────
# Per-Instrument Lot Size Overrides
# Leave commented to use NSE/BSE defaults from the registry.
# Uncomment and adjust ONLY if NSE/BSE revises lot sizes.
# Current verified values (NSE/BSE circulars 2025-26):
#   NIFTY 50   → 65   Tuesday weekly          (NSE)
#   SENSEX     → 20   Thursday weekly         (BSE)
#   BANKNIFTY  → 30   last Tuesday monthly    (NSE)
#   BANKEX     → 30   last Thursday monthly   (BSE)
#   FINNIFTY   → 60   last Tuesday monthly    (NSE)
# ─────────────────────────────────────────────────────────────
#NIFTY_LOT_SIZE=65
#SENSEX_LOT_SIZE=20
#BANKNIFTY_LOT_SIZE=30
#BANKEX_LOT_SIZE=30
#FINNIFTY_LOT_SIZE=60

# ─────────────────────────────────────────────────────────────
# Strategy Settings
# ─────────────────────────────────────────────────────────────
EXPIRY_TYPE=weekly            # weekly | monthly
OPTION_TYPE=CE                # CE | PE | auto (auto picks based on trend)
ENTRY_TIME_START=09:20        # Don't trade before this time (IST)
ENTRY_TIME_END=14:30          # Don't take new entries after this time (IST)
EXIT_ALL_TIME=15:15           # Force close all positions at this time (IST)

# ─────────────────────────────────────────────────────────────
# Indicators (comma-separated, all enabled by default)
# ─────────────────────────────────────────────────────────────
INDICATORS=supertrend,rsi,vwap,ema_crossover
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
EMA_FAST=9
EMA_SLOW=21
SUPERTREND_PERIOD=7
SUPERTREND_MULTIPLIER=3

# ─────────────────────────────────────────────────────────────
# VIX Filter (India VIX)
# Skip trading when VIX is above this threshold (too risky)
# ─────────────────────────────────────────────────────────────
VIX_MAX_THRESHOLD=20

# ─────────────────────────────────────────────────────────────
# Advanced Risk Engine
# ─────────────────────────────────────────────────────────────
MAX_CONSECUTIVE_LOSSES=3      # Stop for the day after N losses in a row
MAX_LOTS_PER_TRADE=1          # Max lots per single trade (increase after profitability proven)
SIZING_METHOD=fixed_fractional # fixed_fractional | kelly | half_kelly
TRAIL_ACTIVATION_POINTS=12    # Activate trailing SL after this many profit points
TRAIL_DISTANCE_POINTS=8       # Trail SL this many points below peak

# ─────────────────────────────────────────────────────────────
# Strategy Selector
# ─────────────────────────────────────────────────────────────
MIN_SIGNAL_CONFIDENCE=6       # Minimum confidence score (0-10) to enter trade
EVENT_IN_DAYS=99              # Days until next major event (RBI/Budget) — set manually
POLL_INTERVAL_SECS=30         # Seconds between each market data check
COST_PER_TRADE=216            # Total transaction cost per round-trip (brokerage+STT+slippage)
MIN_OI_THRESHOLD=100000       # Minimum Open Interest to trade a strike (liquidity gate)

# ─────────────────────────────────────────────────────────────
# Dashboard
# ─────────────────────────────────────────────────────────────
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0
